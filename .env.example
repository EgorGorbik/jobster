# Copy to .env for local development. NEVER commit the real .env.
JOBSTER_DB=./var/jobster.sqlite
JOBSTER_COMPANY=Falcon Jobster
JOBSTER_ADMIN_NAME=Workspace Admin
JOBSTER_ADMIN_EMAIL=admin@example.com
# Use a unique 12+ character password, never the example string below.
JOBSTER_ADMIN_PASSWORD=
PORT=4174
HOST=127.0.0.1
# For TLS-terminated production behind your reverse proxy:
JOBSTER_COOKIE_SECURE=false
# JOBSTER_ORIGIN=https://jobster.example.com

# AI assistant (server-side ONLY). Do not paste a real key into JS/HTML or git.
# AI chat is disabled until the key is set. API usage may incur provider charges.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
