# Copy to .env for local development. NEVER commit the real .env.
JOBSTER_DB=./var/jobster.sqlite
JOBSTER_COMPANY=Falcon Jobster
JOBSTER_ADMIN_NAME=Workspace Admin
JOBSTER_ADMIN_EMAIL=admin@example.com
# Set your own password; never commit the real value.
JOBSTER_ADMIN_PASSWORD=
PORT=4174
HOST=127.0.0.1
# For TLS-terminated production behind your reverse proxy:
JOBSTER_COOKIE_SECURE=false
# JOBSTER_ORIGIN=https://jobster.example.com

# AI assistant (server-side ONLY). Do not paste a real key into JS/HTML or git.
# AI chat is disabled until the key is set. API usage may incur provider charges.
# OpenAI key (sk-...) OR OpenRouter key (sk-or-v1-...) both work in OPENAI_API_KEY.
# Alternatively set OPENROUTER_API_KEY (takes precedence).
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# For OpenRouter use provider/model ids, e.g. openai/gpt-4o-mini
# Bare names like gpt-4.1-mini are auto-prefixed to openai/gpt-4.1-mini on OpenRouter.
OPENAI_MODEL=openai/gpt-4o-mini
# ASSISTANT_PROVIDER=openrouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Public career apply pages (/apply/:slug).
# When Resend is configured, verification emails are sent for real.
# Set true only if you want codes returned in the API / shown in the UI.
JOBSTER_APPLY_DEV_LINKS=false

# Resend (https://resend.com) — outbound email API.
# 1) Create API key → RESEND_API_KEY=re_...
# 2) From must use a domain verified in Resend (e.g. falconai.llc):
#    JOBSTER_MAIL_FROM=Falcon Jobster <jobster@falconai.llc>
RESEND_API_KEY=
JOBSTER_MAIL_FROM=Falcon Jobster <jobster@falconai.llc>
# Also sends sign-in codes when a user chooses Email on the login screen.
# Email candidate only when stage becomes Interview, Offer, or Hired (not New/Screening).
JOBSTER_MAIL_STAGE_NOTIFY=true

# Twilio SMS — sign-in codes plus Interview / Offer / Hired and interview invites.
# Console: Account SID (AC…) on the dashboard + API Key (SK…) + Secret + From number.
# Restricted API keys cannot list accounts — TWILIO_ACCOUNT_SID is required.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
# Sender name (1–11 letters) for countries that reject a US long code, e.g. Georgia (+995).
# Used only after Twilio returns 21612. Default in code is Falcon.
TWILIO_SENDER_ID=Falcon
JOBSTER_SMS_STAGE_NOTIFY=true

# Telegram bot (interview invites + day-before reminders).
# 1) Create a bot with @BotFather → paste token + username (without @).
# 2) Career apply success shows t.me/<username>?start=<candidateId>.
# 3) Candidate presses Start → webhook (or polling) stores chat_id.
# Production: set webhook to https://YOUR_HOST/api/public/telegram/webhook
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://YOUR_HOST/api/public/telegram/webhook" \
#     -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
# Local/dev without public URL: TELEGRAM_USE_POLLING=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_POLLING=false
# Day-before reminders (hourly scan). Set false to disable.
TELEGRAM_REMINDERS=true
