{
  "name": "falcon-jobster-interactive",
  "private": true,
  "version": "2.2.0",
  "description": "Falcon Jobster bilingual green frontend, SQLite backend and server-side OpenAI assistant",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "python tests/browser.py",
    "test:i18n": "python tests/language_browser.py",
    "backend:init": "node --env-file-if-exists=.env server/cli.mjs init",
    "backend:start": "node --env-file-if-exists=.env server/index.mjs",
    "backend:test": "node --test tests/server.test.mjs",
    "test:all": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "nodemailer": "^6.10.1"
  }
}
